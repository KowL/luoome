# luoome 项目级配置（复制为 .env 后填写；.env 已 gitignore，不会入库）
# 加载位置：CLI / web 启动时自动读取 <项目根>/.env 与 $LUOOME_HOME/.env
# 优先级：真实环境变量 > 项目根 .env > $LUOOME_HOME/.env

# ---------- AI 模型目录 ----------
# 默认读取 $LUOOME_HOME/ai-models.json；文件缺失时会自动生成。
# LUOOME_AI_CONFIG=/absolute/path/to/ai-models.json
# 变量名由 ai-models.json 中各 provider 的 apiKeyEnv 指定；目录文件不保存密钥。
MINIMAX_API_KEY=
# MOONSHOT_API_KEY=
# DEEPSEEK_API_KEY=
# ANTHROPIC_API_KEY=
# AI_GATEWAY_API_KEY=

# ---------- 行情（必填） ----------
LUOOME_MARKET_PROVIDER=real

# 从左到右依次作为 primary / fallback / final；省略的数据源即关闭。
# 可选值：eastmoney,tencent,tushare,fuyao。启用 tushare 需同时配置 TUSHARE_TOKEN，
# 启用 fuyao 需同时配置 FUYAO_API_KEY
LUOOME_MARKET_SOURCES=eastmoney,tencent

# ---------- 非行情数据源（连板天梯 / 龙虎榜 / 北向资金 / 要闻 / A 股情绪） ----------
# 逗号分隔的有序数组，从左到右依次 fallback；未知或重复来源启动期报错；缺省 eastmoney。
# 当前可选值仅 eastmoney。
# LUOOME_LIMIT_UP_LADDER_SOURCES=eastmoney
# LUOOME_DRAGON_TIGER_SOURCES=eastmoney
# LUOOME_NORTHBOUND_FLOW_SOURCES=eastmoney
# LUOOME_NEWS_SOURCES=eastmoney
# LUOOME_ASHARE_SENTIMENT_SOURCES=eastmoney

# ---------- 数据目录（缺省 ~/.luoome） ----------
# LUOOME_HOME=/path/to/.luoome

# ---------- 写 / 外部调用能力（默认关闭，显式 opt-in） ----------
# write：创建/修改持仓、策略、关注列表、预警计划等写操作。
# LUOOME_EXPOSE_WRITE=true
# external：行情同步、策略校验与试跑、盯盘扫描等触达外部数据源的调用。
# LUOOME_EXPOSE_EXTERNAL=true
# 仅在本机 loopback 使用建议开启；暴露到非本机访问前请收回（见 docs/SECURITY.md）。

# ---------- TUSHARE 数据服务（未配置时自动回退本地行情） ----------
# https://tushare.pro/document/1?doc_id=130
# TUSHARE_URL=http://api.tushare.pro
# TUSHARE_TOKEN=xxxxxxxxx

# ---------- FUYAO 同花顺数据服务（未配置时不参与行情源） ----------
# https://fuyao.aicubes.cn （登录后 /admin「API Key 管理」签发，完整 Key 仅创建时可见一次）
# FUYAO_API_KEY=xxxxxxxxx
# FUYAO_BASE_URL=https://fuyao.aicubes.cn
