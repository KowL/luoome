# Pass this file explicitly with docker compose --env-file after replacing placeholders.
HOSTED_DOMAIN=luoome.example.invalid
# Optional temporary HTTP origin; keep empty for the normal HTTPS entry.
PUBLIC_ORIGIN=
HOSTED_ALLOW_INSECURE_HTTP=false
LUOOME_RELEASE=reviewed-release-tag
BUN_IMAGE=oven/bun:1.3.14
CADDY_IMAGE=replace-with-reviewed-tag-or-digest
HOSTED_REGISTRATION_ENABLED=false
HOSTED_REGISTRATION_LIMIT=30
HOSTED_RUNTIME_LIMIT=16
# Integer provider-cost budget per job, in micro-yuan; set from the reviewed plan.
HOSTED_JOB_BUDGET_MICRO=replace-with-positive-integer
HOSTED_AI_ENABLED=false
# Empty SMTP_HOST keeps email unavailable; readiness stays false and registration must remain closed.
SMTP_HOST=
SMTP_PORT=465
SMTP_FROM=
SMTP_USER=
# Set false only with a STARTTLS SMTP endpoint (for example port 587).
SMTP_SECURE=true
