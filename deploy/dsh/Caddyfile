# 单机形态的公网入口：整个站点只有 DSH。
#
# 托管站点已下线，站点根路径直接指向 DSH 面板。
# 域名的 ACME 校验会被运营商 DNS 劫持（DNSPod webblock）打断，
# 443 上的 TLS 握手同样被中间设备重置，因此公网 IP 入口只能明文 HTTP。
# DSH_AUTH_* 未配置时 basic auth 校验失败（fail closed），不会放开 /dsh/。
http://{$DSH_PUBLIC_IP:134.175.83.56} {
  redir / /dsh/ 302
  redir /dsh /dsh/ 302
  handle_path /dsh/* {
    basic_auth * {
      {$DSH_AUTH_USER:dsh} {$DSH_AUTH_HASH:unset}
    }
    reverse_proxy dsh-web:3080
  }
  handle {
    redir /dsh/ 302
  }
}
