# 独立 DSH 默认部署（Web + Caddy 入口）配置（deploy/dsh/compose.yaml）。
# 复制为私有 env 文件后由运营填写；不要提交到 Git。
#
# 默认部署已切纯插件：DSH 用 Node 加载 dsh-luoome 插件（host/client/skills），
# 事实库是 LUOOME_HOME/luoome.db（Node SQLite）；不启动 MCP 实例、Bun CLI、
# 旧 Bun Web、analysis worker 或 queue probe。安装/升级/备份/回退步骤见 docs/USER_GUIDE.md。

# 镜像标签：与源码快照一一对应，必须不可变。
LUOOME_RELEASE=dsh-20261023T000000Z

# 基础镜像：BUN_IMAGE 只用于构建阶段打包插件；运行阶段只用 NODE_IMAGE（DSH + 插件）。
BUN_IMAGE=oven/bun@sha256:e10577f0db68676a7024391c6e5cb4b879ebd17188ab750cf10024a6d700e5c4
NODE_IMAGE=node:22.22.3-bookworm-slim
DSH_VERSION=0.2.1-rc.2

# 公网入口用的 Caddy 镜像（固定 digest 或已审核的 tag）。
CADDY_IMAGE=caddy:2.10.2-alpine

# DSH Web 的监听地址必须是容器内的一个具体 IP（DSH 拒绝通配地址）。
DSH_BIND_HOST=172.28.0.5
DSH_PORT=3080

# 浏览器可见的根地址与受信 authority，两者都要与 Caddy 的反代前缀一致。
DSH_PUBLIC_URL=http://134.175.83.56/dsh/
DSH_TRUSTED_HOST=134.175.83.56

# owner 绑定：必须是既有 Node SQLite 事实库中的账户，插件不从 HTTP/模型参数推断账户。
LUOOME_OWNER_USER_ID=owner
LUOOME_OWNER_ACCOUNT_ID=default

# 批处理需单次确认；定时执行还需逐任务原生审批的 AutomationGrant。
LUOOME_BATCH_ENABLED=false
LUOOME_AUTOMATIONS_ENABLED=false

# 插件事实库目录（compose 已映射为 luoome_home 卷）与真实行情供应商。
# Node SQLite 是唯一事实库；升级/回退前必须先做一致性备份，见 docs/USER_GUIDE.md。
LUOOME_HOME=/var/lib/luoome
LUOOME_MARKET_PROVIDER=real
LUOOME_STOCK_UNIVERSE_SOURCES=eastmoney,sina

# Caddy 侧 /dsh/ 路径的 basic auth。
# DSH_AUTH_HASH 用 `caddy hash-password` 生成；留空即 fail closed。
DSH_AUTH_USER=dsh
DSH_AUTH_HASH=
