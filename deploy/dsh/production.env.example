# 独立 DSH 部署配置（deploy/dsh/compose.yaml）。
# 复制为私有 env 文件后由运营填写；不要提交到 Git。

# 镜像标签：与源码快照一一对应，必须不可变。
LUOOME_RELEASE=dsh-20261023T000000Z

# 基础镜像（固定 digest 或已审核的 tag）。
BUN_IMAGE=oven/bun@sha256:e10577f0db68676a7024391c6e5cb4b879ebd17188ab750cf10024a6d700e5c4
NODE_IMAGE=node:22.22.3-bookworm-slim
DSH_VERSION=0.2.1-rc.2

# 公网入口用的 Caddy 镜像（固定 digest 或已审核的 tag）。
CADDY_IMAGE=caddy:2.10.2-alpine

# DSH Web 的监听地址必须是容器内的一个具体 IP（DSH 拒绝通配地址）。
DSH_BIND_HOST=172.28.0.5
DSH_PORT=3080

# 浏览器可见的根地址与受信 authority，两者都要与 Caddy 的反代前缀一致。
DSH_PUBLIC_URL=http://134.175.83.56/dsh/
DSH_TRUSTED_HOST=134.175.83.56

# 传给 luoome 业务进程的环境变量（分号分隔 k=v）。
# 暴露面开关由 profile 补丁控制，这里不接受覆盖。
LUOOME_MCP_ENV=LUOOME_MARKET_PROVIDER=real;LUOOME_STOCK_UNIVERSE_SOURCES=eastmoney,sina

# 消费者轮询间隔（秒）与每轮交给 DSH 的任务描述。
DSH_WORKER_INTERVAL=60

# Caddy 侧 /dsh/ 路径的 basic auth。
# DSH_AUTH_HASH 用 `caddy hash-password` 生成；留空即 fail closed。
DSH_AUTH_USER=dsh
DSH_AUTH_HASH=
